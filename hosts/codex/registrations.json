{
  "version": 1,
  "note": "Codex 注册真源——render-codex-hooks.cjs 从此渲染 ~/.codex/hooks.json；命令用 ${HARNESS_ROOT} 占位（渲染期解析为绝对路径）",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${HARNESS_ROOT}/core/engine/scripts/hooks/frustration-detector.cjs"
          },
          {
            "type": "command",
            "command": "node \"${HARNESS_ROOT}/hosts/codex/patch-hook.cjs\" context",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ${HARNESS_ROOT}/core/engine/scripts/hooks/local-runner.cjs --batch \"verification-gate.cjs,pre-commit-lint.cjs,diff-size-gate.cjs,resource-budget-gate.cjs,bash-safety-guard.cjs\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ${HARNESS_ROOT}/core/engine/scripts/context-monitor-gate.cjs"
          },
          {
            "type": "command",
            "command": "node \"${HARNESS_ROOT}/hosts/codex/patch-hook.cjs\" protect"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${HARNESS_ROOT}/hosts/codex/patch-hook.cjs\" write"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${HARNESS_ROOT}/hosts/codex/patch-hook.cjs\" verify"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${HARNESS_ROOT}/hosts/codex/patch-hook.cjs\" observe",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${HARNESS_ROOT}/core/engine/scripts/pre-compact.cjs --quiet"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${HARNESS_ROOT}/core/engine/scripts/ecc-root-resolver.cjs\" --session-start",
            "standaloneOnly": true,
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "node ${HARNESS_ROOT}/core/engine/scripts/state-resume.cjs --session-start"
          },
          {
            "type": "command",
            "command": "node ${HARNESS_ROOT}/core/engine/scripts/context-resume.cjs --session-start",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node ${HARNESS_ROOT}/core/engine/scripts/dream-startup-inject.cjs --session-start"
          },
          {
            "type": "command",
            "command": "node ${HARNESS_ROOT}/core/engine/scripts/hooks/isolation-check.cjs"
          },
          {
            "type": "command",
            "command": "node ${HARNESS_ROOT}/core/engine/scripts/memory-knowledge-maintenance.cjs --auto --execute --quiet",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node ${HARNESS_ROOT}/core/engine/scripts/consumer-scheduler.cjs --auto",
            "timeout": 75
          }
        ]
      },
      {
        "matcher": "^startup$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${HARNESS_ROOT}/core/engine/scripts/hooks/codegraph-sync.cjs\" --session",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${HARNESS_ROOT}/core/engine/scripts/hooks/lint-auto-gate.cjs"
          },
          {
            "type": "command",
            "command": "node ${HARNESS_ROOT}/core/engine/scripts/hooks/context-pressure-warn.cjs"
          },
          {
            "type": "command",
            "command": "node ${HARNESS_ROOT}/core/engine/hooks/git/git-integrity-guard.cjs --workspace",
            "timeout": 15000
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${HARNESS_ROOT}/hosts/codex/patch-hook.cjs\" observe",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${HARNESS_ROOT}/hosts/codex/patch-hook.cjs\" context",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
