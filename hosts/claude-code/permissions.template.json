{
  "$schema": "harness/hosts/claude-code/permissions.template.json — settings.local.json 结构模板(Phase 3.3)",
  "note": "新机器复制本模板为 ~/.claude/settings.local.json 后按需增补; env 调参项由本机自行维护, 不走分发",
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "WebFetch",
      "NotebookEdit",
      "Bash(git push:*)",
      "PowerShell(git push:*)"
    ],
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push origin master)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f*:*)",
      "Bash(git branch -D:*)",
      "Bash(git checkout -- *:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(git push --delete:*)",
      "Bash(git push origin :*)",
      "Bash(git tag -d:*)",
      "Bash(gh repo delete:*)",
      "Bash(git commit --amend:*)",
      "PowerShell(git push origin main)",
      "PowerShell(git push origin master)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git clean -f*:*)",
      "PowerShell(git branch -D:*)",
      "PowerShell(git checkout -- *:*)",
      "PowerShell(git push --delete:*)",
      "PowerShell(git push origin :*)",
      "PowerShell(git tag -d:*)",
      "PowerShell(gh repo delete:*)",
      "PowerShell(git commit --amend:*)",
      "PowerShell(Remove-Item -Recurse -Force /:*)",
      "PowerShell(Remove-Item -Recurse -Force ~:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(git commit:*)",
      "PowerShell(git push:*)",
      "PowerShell(gh pr merge:*)",
      "PowerShell(git commit:*)"
    ],
    "defaultMode": "acceptEdits"
  }
}
