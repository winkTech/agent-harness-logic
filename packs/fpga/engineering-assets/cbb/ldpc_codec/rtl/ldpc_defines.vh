//-----------------------------------------------------------------
//                       LDPC Decoder Defines
//-----------------------------------------------------------------
// 功能描述: 802.11n QC-LDPC 译码器全局宏定义
// 使用: `include "ldpc_defines.vh" (在模块内部)
//-----------------------------------------------------------------

    //-----------------------------------------------------------------
    // 码参数 (802.11n R=1/2, N=648, Z=27)
    //-----------------------------------------------------------------
    `define P_N                648
    `define P_K                324
    `define P_M                324
    `define P_Z                27
    `define P_MB               12
    `define P_NB               24

    //-----------------------------------------------------------------
    // H 矩阵参数
    //-----------------------------------------------------------------
    `define P_H_NNZ            2376
    `define P_MAX_ROW_WT       8
    `define P_MAX_COL_WT       3

    //-----------------------------------------------------------------
    // 定点量化参数 Q(10,4)
    //-----------------------------------------------------------------
    `define P_Q_DATA_W         10
    `define P_Q_FRAC           4

    //-----------------------------------------------------------------
    // Min-Sum 参数
    //-----------------------------------------------------------------
    `define P_ALPHA_FIXED      12
    `define P_MAX_ITER         20

    //-----------------------------------------------------------------
    // 地址位宽
    //-----------------------------------------------------------------
    `define P_LLR_ADDR_W       10
    `define P_ROW_ADDR_W       9
    `define P_COL_ADDR_W       10
    `define P_SHIFT_W          5
    `define P_CONN_CNT_W       4
