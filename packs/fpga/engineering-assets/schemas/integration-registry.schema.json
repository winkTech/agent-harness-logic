{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "engineering-assets/schemas/integration-registry.schema.json",
  "title": "CBB integration registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner", "entries"],
  "properties": {
  "schema_version": { "type": "string", "const": "1.1" },
    "owner": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "project", "project_ref", "asset_uid", "version_pinned", "config", "integrated_at", "status", "owner", "consumers", "issues", "badge_gap"],
        "properties": {
          "id": { "type": "string", "pattern": "^ITG-[0-9]{4}$" },
          "project": { "type": "string", "minLength": 1 },
          "project_ref": { "type": "string", "minLength": 1 },
          "asset_uid": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "version_pinned": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "config": { "type": "object", "additionalProperties": true },
          "integrated_at": { "type": "string", "format": "date-time" },
          "status": { "type": "string", "enum": ["active", "retired"] },
          "maturity_status": { "type": "string", "enum": ["internal-validation", "deferred", "evidence-only", "integrated", "deprecated"] },
          "owner": { "type": "string" },
          "consumers": { "type": "array", "items": { "type": "string" } },
          "issues": { "type": "array", "items": { "type": "string" } },
          "badge_gap": { "type": "array", "items": { "type": "string" } },
          "deferred_reason": { "type": "string" },
          "last_reviewed": { "type": "string" }
        }
      }
    }
  }
}
