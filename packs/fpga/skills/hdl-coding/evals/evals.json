{
  "skill": "hdl-coding",
  "version": "3.8.0",
  "description": "HDL coding skill evals — 断言覆盖 5 条红线（ri_ 输入寄存 / ro_ 输出驱动 / 同步复位 / 三段式 FSM + default / 无锁存器结构）+ §10 Vivado 综合可预测性（BRAM 推断与复位豁免）",
  "evals": [
    {
      "name": "verilog-module-basic",
      "description": "创建一个基本的 Verilog 模块",
      "prompt": "编写一个 Verilog 模块实现 8 位计数器，带同步复位和使能信号",
      "expected_outputs": {
        "has_module_declaration": true,
        "has_clock_input": true,
        "has_reset_input": true,
        "has_enable_input": true,
        "has_counter_output": true,
        "follows_naming_convention": true
      },
      "assertions": [
        {
          "type": "file_exists",
          "pattern": "*.v",
          "description": "Verilog 文件存在"
        },
        {
          "type": "content_match",
          "pattern": "module\\s+\\w*counter",
          "description": "包含计数器模块"
        },
        {
          "type": "content_match",
          "pattern": "input\\s+(wire\\s+)?i_clk",
          "description": "包含时钟输入（i_ 前缀）"
        },
        {
          "type": "content_match",
          "pattern": "input\\s+(wire\\s+)?i_rst",
          "description": "包含复位输入（i_ 前缀）"
        },
        {
          "type": "content_match",
          "pattern": "output\\s+[^;]*o_\\w+",
          "description": "包含输出信号（o_ 前缀）"
        },
        {
          "type": "content_match",
          "pattern": "\\bri_\\w+",
          "description": "红线 1：输入寄存为 ri_"
        },
        {
          "type": "content_match",
          "pattern": "\\bro_\\w+",
          "description": "红线 2：输出由 ro_ 驱动"
        },
        {
          "type": "content_match",
          "pattern": "always\\s*@\\s*\\(\\s*posedge\\s+i_clk\\s*\\)",
          "description": "红线 3：同步时序逻辑（敏感列表仅 posedge i_clk，无异步复位项）"
        }
      ]
    },
    {
      "name": "fsm-design",
      "description": "设计一个有限状态机",
      "prompt": "编写一个 Verilog 状态机实现交通灯控制器，包含红、黄、绿三个状态",
      "expected_outputs": {
        "has_state_definition": true,
        "has_state_transition": true,
        "has_output_logic": true,
        "uses_three_block_style": true,
        "has_default_branch": true
      },
      "assertions": [
        {
          "type": "content_match",
          "pattern": "localparam\\s+(\\[[^\\]]+\\]\\s*)?P_\\w+",
          "description": "状态用 localparam + P_ 前缀定义（§2/§4）"
        },
        {
          "type": "content_match",
          "pattern": "case\\s*\\(",
          "description": "包含状态转移 case 逻辑"
        },
        {
          "type": "content_match",
          "pattern": "default\\s*:",
          "description": "红线 4/5：case 含 default 分支"
        },
        {
          "type": "content_match",
          "pattern": "always\\s*@\\s*\\(\\s*posedge\\s+i_clk\\s*\\)",
          "description": "状态寄存器为同步时序逻辑"
        },
        {
          "type": "content_match",
          "pattern": "always\\s*@\\s*\\(\\s*\\*\\s*\\)|always_comb",
          "description": "红线 4：三段式含独立组合逻辑段（次态判断）"
        }
      ]
    },
    {
      "name": "pipeline-design",
      "description": "设计一个流水线模块",
      "prompt": "编写一个 4 级流水线的加法器，每级处理 8 位数据",
      "expected_outputs": {
        "has_pipeline_stages": true,
        "has_stage_registers": true,
        "follows_timing_rules": true
      },
      "assertions": [
        {
          "type": "content_match",
          "pattern": "reg\\s+[^;]*(stage|pipe|r_\\w+)",
          "description": "包含流水线寄存器"
        },
        {
          "type": "content_match",
          "pattern": "always\\s*@\\s*\\(\\s*posedge\\s+i_clk\\s*\\)",
          "description": "使用同步时钟逻辑"
        },
        {
          "type": "content_match",
          "pattern": "\\bri_\\w+",
          "description": "红线 1：输入寄存为 ri_"
        },
        {
          "type": "content_match",
          "pattern": "\\bro_\\w+",
          "description": "红线 2：输出由 ro_ 驱动"
        }
      ]
    },
    {
      "name": "bram-inference",
      "description": "存储器模块 — 验证 §10 Vivado 综合可预测性（BRAM 推断不被复位阻断）",
      "prompt": "编写一个 1024×8 位的单端口同步 RAM 模块，目标器件 Xilinx Artix-7，要求综合后映射到 Block RAM",
      "expected_outputs": {
        "infers_block_ram": true,
        "read_addr_registered": true,
        "no_reset_on_read_data_reg": true,
        "documents_reset_exemption": true
      },
      "assertions": [
        {
          "type": "content_match",
          "pattern": "always(_ff)?\\s*@\\s*\\(\\s*posedge\\s+i_clk\\s*\\)",
          "description": "同步读写（异步读会掉成分布式 RAM）"
        },
        {
          "type": "content_match",
          "pattern": "复位豁免|ram_style|RAM_STYLE",
          "description": "§10.2/§5.1：读数据寄存器不加复位须有豁免注释，或显式用 RAM_STYLE 属性声明意图"
        },
        {
          "type": "content_not_match",
          "pattern": "if\\s*\\(\\s*i_rst\\s*\\)[^;]*ro_rdata",
          "description": "§10.2：BRAM 输出寄存器带复位会导致输出寄存器吸收失败（Fmax 崩）"
        }
      ]
    }
  ]
}
