        "mcp-pdf@1.1.0"
      ]
    },
    "codegraph": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/core/engine/mcp/codegraph-server.cjs"
      ],
      "env": {}
    }
  }
}
