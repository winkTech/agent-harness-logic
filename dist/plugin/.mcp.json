{
  "mcpServers": {
    "matlab": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/core/engine/mcp/matlab-server.cjs"
      ]
    },
    "mcp-pdf": {
      "command": "npx",
      "args": [
