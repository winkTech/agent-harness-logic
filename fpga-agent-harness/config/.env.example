# FPGA Agent Harness 环境变量配置
# 复制此文件为 .env 并填入实际值

# ============================================================
# LLM API 配置
# ============================================================

# 方案1: 小米 mimo API（默认）
ANTHROPIC_AUTH_TOKEN=your_token_here
ANTHROPIC_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic

# 方案2: 本地 vLLM
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_MODEL=your-model-name
# VLLM_API_KEY=EMPTY

# 方案3: OpenAI API
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================================
# FPGA 工具链配置
# ============================================================

# Vivado 路径（留空使用系统 PATH）
VIVADO_PATH=

# ModelSim 路径（留空使用系统 PATH）
MODELSIM_PATH=

# MATLAB 路径（留空使用系统 PATH）
MATLAB_PATH=

# ============================================================
# 开发环境配置
# ============================================================

# 默认工作目录
DEFAULT_WORKDIR=C:/Users/Lihan/Documents/FPGA

# 日志级别
LOG_LEVEL=INFO

# ============================================================
# 安全配置
# ============================================================

# 命令超时（秒）
COMMAND_TIMEOUT=120

# 最大文件大小（字节）
MAX_FILE_SIZE=10485760
