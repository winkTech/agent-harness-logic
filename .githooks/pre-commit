#!/bin/bash
# ============================================================================
# Git pre-commit hook for FPGA/ASIC projects
# 安装: git config core.hooksPath .githooks
# 功能: 分支保护 | 大文件检查 | 调试标记 | 仿真垃圾清理 | SV/VHDL/Python 语法检查
# ============================================================================

# ─── 根目录保护 ────────────────────────────────────────────────────────────
# 确保在 git 仓库根目录运行，防止 CWD 偏移导致的路径误判
PROJECT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "❌ 无法确定 git 仓库根目录，请在 git 仓库内运行"
  exit 1
}
cd "$PROJECT_ROOT" || exit 1

echo "=== [Pre-Commit] 开始检查 ==="
echo "   仓库: $(basename "$PROJECT_ROOT")"

# ─── --no-verify 提醒 ────────────────────────────────────────────────────
if [ -n "$BYPASS_PRE_COMMIT" ] || [ -n "$SKIP_PRECOMMIT" ]; then
  echo "⚠️  检测到跳过标记。注意：--no-verify 会绕过所有检查，"
  echo "   请确保手动运行了 lint 和语法检查。"
fi

# ---- 基础变量 ----
STAGED=$(git diff --cached --name-only --diff-filter=ACM)
ALL_STAGED=$(git diff --cached --name-only)
HAS_ERROR=0
HAS_WARN=0

check_cmd() { command -v "$1" &> /dev/null; }

# ============================================================================
# 1. 分支保护：禁止在 main 上直接提交
# ============================================================================
BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$BRANCH" = "main" ]; then
  echo "❌ 禁止在 main 分支上直接提交！请先切到功能分支。"
  exit 1
fi
echo "✅ 当前分支: $BRANCH"

# ============================================================================
# 2. 大文件检查（暂存区 >50MB）
# ============================================================================
LARGE_FILES=$(git diff --cached --name-only -z | xargs -0 ls -la 2>/dev/null | awk '$5 > 50000000 {print $NF}')
if [ -n "$LARGE_FILES" ]; then
  echo "❌ 发现大文件被暂存（>50MB），请添加到 .gitignore："
  echo "$LARGE_FILES"
  exit 1
fi
echo "✅ 无大文件"

# ============================================================================
# 3. 调试代码标记检查
# ============================================================================
if echo "$ALL_STAGED" | grep -qE '\.(v|sv|vhd|m|py)$'; then
  if git diff --cached -U0 | grep -E "^\+.*\/\/(\s*DEBUG|\s*TODO|\s*FIXME)" > /dev/null 2>&1; then
    echo "⚠️  警告：暂存区中包含 DEBUG/TODO/FIXME 标记，请确认是预期提交的代码"
    HAS_WARN=1
  fi
fi

# ============================================================================
# 4. .gitignore 存在性检查
# ============================================================================
if [ ! -f ".gitignore" ]; then
  echo "⚠️  警告：项目根目录下没有 .gitignore 文件"
  HAS_WARN=1
fi

# ============================================================================
# 5. 仿真/综合垃圾文件检查（暂存区 + 工作区 + 未跟踪文件）
# ============================================================================

# 排除目录（这些路径下的 work/ 等是正常数据）
# engineering-assets/ 三条: golden 向量(.bin)、资产包 vectors-ref/(规范 §5.1)、
# vendored 上游工程(含 Quartus .rpt) 均是受治理资产，不是仿真垃圾。
# 注意: 排除按路径子串匹配，资产迁出 knowledge/ 后必须由这几条接住。
# engineering-assets/var/build/ 是门禁 runner 与 run.do 的独立构建目录（已 gitignore），
# transcript/work 等仿真产物本就该落在那里，不构成仓库污染。
# engineering-assets/var/gates/ 是门禁证据目录（已 gitignore）：G-C-01/02 的判据
# 就来自其中的 timing-summary.rpt / utilization.rpt，它们是刻意产出的证据而非垃圾，
# 由 tools/pg-synth.cjs 可重生。误删会让门禁失去判据来源。
# engineering-assets/evidence/ 是证据快照目录（内含的 .dcp/.rpt 已 gitignore）：
# 与 var/gates/ 同性质 —— SNAPSHOT.json 记录各门判据，同目录下的 Vivado
# post_synth.dcp 是可由综合重跑再生的中间检查点。此前该目录未列入豁免，
# 导致本扫描把它当垃圾并阻断**与之无关**的提交。
EXCLUDE_DIRS="memory/work/|plugins/cache/|knowledge/|.git/|engineering-assets/.*/vectors/|engineering-assets/.*/vectors-ref/|engineering-assets/reference-assets/|engineering-assets/var/build/|engineering-assets/var/gates/|engineering-assets/evidence/"

# ---- 5a. 暂存区检查：禁止仿真文件被提交 ----
FORBIDDEN_STAGED_PATTERNS="(^|/)transcript$|vsim\.wlf|\.vcd$|\.wlftmp|vsim\.dump|\.wdb$|xsim\.jou|xsim\.log|xsim\.tcl|xelab\.pb|xvlog\.pb|tr_db\.log|wev\.log|vlog\.log"
MATCH_STAGED=$(echo "$ALL_STAGED" | grep -E "$FORBIDDEN_STAGED_PATTERNS" | grep -vE "$EXCLUDE_DIRS" | head -10)
if [ -n "$MATCH_STAGED" ]; then
  echo "❌ 仿真产物不应提交到 git（已在暂存区）："
  echo "$MATCH_STAGED"
  echo ""
  echo "  修复: git rm --cached <文件>  # 取消暂存"
  exit 1
fi
echo "✅ 暂存区无仿真产物"

# ---- 5b. 工作区 + 未跟踪文件扫描：发现垃圾则阻止提交并引导清理 ----
GARBAGE_PATTERNS="
  # 波形文件
  \.vcd$|\.vcd\.gz$|\.vpd$|\.fsdb$
  # Vivado xsim 日志/缓存
  \.wdb$|xsim\.dir/|xsim\.jou|xsim\.log|xsim\.tcl|\.pb$
  # ModelSim / Questa 产物
  transcript$|\.wlf$|\.wlftmp|\.mpf$|\.ucdb$|\.vstf$
  # 综合产物
  \.bit$|\.bin$|\.mcs$|\.ltx$|\.dcp$|\.rpt$|\.ngc$|\.edf$|\.edif$
  # 虚拟内存 / Dump
  \.dump$|\.stackdump$|\.core$|\.dmp$
  # 编译日志
  tr_db\.log$|wev\.log$|vlog\.log$|xelab\.pb$|xvlog\.pb$
  # 仿真缓存
  work/$
"

# 合并为一行正则 (移除注释和空行)
GARBAGE_REGEX=$(echo "$GARBAGE_PATTERNS" | grep -v '^\s*#' | grep -v '^\s*$' | tr -d ' \t' | paste -sd '|')

# 扫描: 未跟踪文件（含 gitignore 忽略的）+ 工作区修改
GARBAGE_FILES=$(
  {
    # 未跟踪文件（含被 .gitignore 隐藏的仿真垃圾）
    git ls-files --others | grep -E "$GARBAGE_REGEX" | grep -vE "$EXCLUDE_DIRS"
    # 已跟踪但被修改的文件（如旧版遗留的仿真文件）
    git ls-files --modified | grep -E "$GARBAGE_REGEX" | grep -vE "$EXCLUDE_DIRS"
  } | sort -u | head -20
)

if [ -n "$GARBAGE_FILES" ]; then
  # 过滤掉零字节文件（被 OS 锁定但已清空的僵尸文件）
  REAL_GARBAGE=""
  ZOMBIE_FILES=""
  while read -r f; do
    if [ -s "$f" ]; then
      REAL_GARBAGE="$REAL_GARBAGE
$f"
    else
      ZOMBIE_FILES="$ZOMBIE_FILES
$f"
    fi
  done <<< "$GARBAGE_FILES"

  if [ -n "$ZOMBIE_FILES" ]; then
    echo "⚠️  发现零字节残留文件（可能被僵尸进程锁定，重启后清理）："
    echo "$ZOMBIE_FILES" | head -10 | while read -r f; do
      [ -n "$f" ] && echo "    • $f"
    done
    echo ""
  fi

  if [ -n "$REAL_GARBAGE" ]; then
    echo ""
    echo "⚠️ ⚠️ ⚠️ ⚠️ ⚠️ ⚠️ ⚠️ ⚠️ ⚠️ ⚠️ ⚠️ ⚠️ ⚠️ ⚠️ ⚠️ "
    echo "   发现仿真/综合垃圾文件！提交已阻止"
    echo "⚠️ ⚠️ ⚠️ ⚠️ ⚠️ ⚠️ ⚠️ ⚠️ ⚠️ ⚠️ ⚠️ ⚠️ ⚠️ ⚠️ ⚠️ "
    echo ""
    echo "$REAL_GARBAGE" | while read -r f; do
      [ -n "$f" ] && SIZE=$(ls -la "$f" 2>/dev/null | awk '{print $5}' | numfmt --to=iec 2>/dev/null || echo "") && [ -n "$SIZE" ] && printf "  • %s  (%s)\n" "$f" "$SIZE" || printf "  • %s\n" "$f"
    done
    echo ""
    echo "  清理方法:"
    echo "    git clean -fdn          # 预览将删除的未跟踪文件"
    echo "    git clean -fd           # 确认删除未跟踪垃圾文件"
    echo "    rm -rf <文件/目录>     # 手动删除跟踪过的垃圾文件"
    echo "    git checkout -- <文件>  # 恢复意外修改的跟踪文件"
    echo ""
    exit 1
  fi  # REAL_GARBAGE
fi  # GARBAGE_FILES
echo "✅ 工作区无仿真垃圾文件"

# ============================================================================
# 6. Verilog / SystemVerilog 语法检查
# ============================================================================
# UVM 源无法用裸 vlog -lint 单文件检查（需 -L uvm 与包编译顺序），故豁免。
# 资产包布局为 tb/uvm/，旧 knowledge 布局为 uvm_tb/，两者都要排除。
SV_FILES=$(echo "$STAGED" | grep -E '\.(v|sv)$' | grep -v '/examples/' | grep -v '/reference-assets/vendor/' | grep -v '/templates/' | grep -v '/uvm_tb/' | grep -v '/tb/uvm/')
if [ -n "$SV_FILES" ]; then
  if check_cmd vlog; then
    echo "--- [vlog] 检查 Verilog/SV 语法 ---"
    for f in $SV_FILES; do
      if [ -f "$f" ]; then
        OUTPUT=$(timeout 30 vlog -lint "$f" 2>&1)
        ERRORS=$(echo "$OUTPUT" | grep -cE "^(# )?\*\* Error")
        WARNINGS=$(echo "$OUTPUT" | grep -cE "^(# )?\*\* Warning")
        if [ "$ERRORS" -gt 0 ]; then
          echo "❌ $f — $ERRORS 个错误, $WARNINGS 个警告"
          echo "$OUTPUT" | grep -E "^\*\* Error" | head -5 | sed 's/^/  /'
          HAS_ERROR=1
        else
          echo "✅ $f — $WARNINGS 个警告"
        fi
      fi
    done
  else
    echo "⚠️  未找到 vlog 命令，跳过 SV 检查"
  fi
fi

# ============================================================================
# 7. VHDL 语法检查
# ============================================================================
VHD_FILES=$(echo "$STAGED" | grep -E '\.(vhd|vhdl)$' | grep -v '/examples/' | grep -v '/reference-assets/vendor/' | grep -v '/templates/')
if [ -n "$VHD_FILES" ]; then
  if check_cmd vcom; then
    echo "--- [vcom] 检查 VHDL 语法 ---"
    for f in $VHD_FILES; do
      if [ -f "$f" ]; then
        OUTPUT=$(timeout 30 vcom -lint "$f" 2>&1)
        ERRORS=$(echo "$OUTPUT" | grep -cE "^(# )?\*\* Error")
        WARNINGS=$(echo "$OUTPUT" | grep -cE "^(# )?\*\* Warning")
        if [ "$ERRORS" -gt 0 ]; then
          echo "❌ $f — $ERRORS 个错误, $WARNINGS 个警告"
          echo "$OUTPUT" | grep -E "^\*\* Error" | head -5 | sed 's/^/  /'
          HAS_ERROR=1
        else
          echo "✅ $f — $WARNINGS 个警告"
        fi
      fi
    done
  else
    echo "⚠️  未找到 vcom 命令，跳过 VHDL 检查"
  fi
fi

# ============================================================================
# 8. Python 语法和 lint 检查
# ============================================================================
PY_FILES=$(echo "$STAGED" | grep -E '\.py$' | grep -v '/examples/' | grep -v '/reference-assets/vendor/' | grep -v '/templates/' | grep -v 'node_modules/' | grep -v '/plugins/cache/' | grep -v '/skills/.*/scripts/' | grep -v '/skills/.*/tools/')
if [ -n "$PY_FILES" ]; then
  PYTHON_CMD=""
  if python -c "" &>/dev/null; then
    PYTHON_CMD="python"
  elif python3 -c "" &>/dev/null; then
    PYTHON_CMD="python3"
  fi

  if [ -n "$PYTHON_CMD" ]; then
    echo "--- [$PYTHON_CMD] 语法检查 ---"
    for f in $PY_FILES; do
      if [ -f "$f" ]; then
        OUTPUT=$(timeout 15 $PYTHON_CMD -m py_compile "$f" 2>&1)
        if [ -n "$OUTPUT" ]; then
          echo "❌ $f 语法错误"
          echo "$OUTPUT" | sed 's/^/  /'
          HAS_ERROR=1
        else
          echo "✅ $f 语法通过"
        fi
      fi
    done
  fi

  if check_cmd flake8; then
    echo "--- [flake8] 代码风格检查 ---"
    for f in $PY_FILES; do
      if [ -f "$f" ]; then
        OUTPUT=$(timeout 30 flake8 --max-line-length=100 "$f" 2>&1)
        if [ -n "$OUTPUT" ]; then
          echo "⚠️  $f"
          echo "$OUTPUT" | head -10 | sed 's/^/  /'
          HAS_WARN=1
        else
          echo "✅ $f flake8 通过"
        fi
      fi
    done
  fi

  if check_cmd ruff; then
    echo "--- [ruff] 代码检查 ---"
    for f in $PY_FILES; do
      if [ -f "$f" ]; then
        OUTPUT=$(timeout 30 ruff check "$f" 2>&1)
        if [ -n "$OUTPUT" ]; then
          echo "⚠️  $f"
          echo "$OUTPUT" | head -10 | sed 's/^/  /'
          HAS_WARN=1
        else
          echo "✅ $f ruff 通过"
        fi
      fi
    done
  fi

  if ! check_cmd flake8 && ! check_cmd ruff; then
    echo "⚠️  建议安装 linter: pip install flake8 或 pip install ruff"
  fi
fi

# ============================================================================
# 9. MATLAB 代码检查（仅 matlab 安装时启用）
# ============================================================================
M_FILES=$(echo "$STAGED" | grep -E '\.m$' | grep -v '/examples/' | grep -v '/reference-assets/vendor/' | grep -v '/templates/')
if [ -n "$M_FILES" ]; then
  if check_cmd matlab; then
    echo "--- [MATLAB] 代码分析 ---"
    for f in $M_FILES; do
      if [ -f "$f" ]; then
        OUTPUT=$(timeout 120 matlab -batch "checkcode('$f'); exit;" 2>&1)
        if echo "$OUTPUT" | grep -qi "error\|警告\|L \d"; then
          echo "⚠️  $f 存在代码分析问题："
          echo "$OUTPUT" | grep -E "L \d|Error|警告" | head -10 | sed 's/^/  /'
          HAS_WARN=1
        else
          echo "✅ $f MATLAB 分析通过"
        fi
      fi
    done
  else
    echo "⚠️  未找到 matlab 命令，跳过 .m 文件检查"
  fi
fi

# ============================================================================
# 10. Tcl / .do / .xdc / .sdc 语法检查
# ============================================================================
TCL_FILES=$(echo "$STAGED" | grep -E '\.(tcl|do|xdc|sdc)$' | grep -v '/examples/' | grep -v '/reference-assets/vendor/' | grep -v '/templates/')
if [ -n "$TCL_FILES" ]; then
  if check_cmd tclsh; then
    echo "--- [tclsh] Tcl 语法检查 ---"
    for f in $TCL_FILES; do
      if [ -f "$f" ]; then
        OUTPUT=$(timeout 15 tclsh -c "source \"$f\"" 2>&1)
        ERRORS=$(echo "$OUTPUT" | grep -cE "error|Error|ERROR|unknown|invalid")
        if [ "$ERRORS" -gt 0 ]; then
          echo "❌ $f — Tcl 语法错误"
          echo "$OUTPUT" | head -5 | sed 's/^/  /'
          HAS_ERROR=1
        else
          echo "✅ $f 语法通过"
        fi
      fi
    done
  else
    echo "⚠️  未找到 tclsh 命令，跳过 Tcl 检查"
  fi
fi

# ============================================================================
# 结果汇总
# ============================================================================
echo ""
if [ "$HAS_ERROR" -gt 0 ]; then
  echo "=== [Pre-Commit] ❌ 存在语法错误，提交被阻止 ==="
  exit 1
elif [ "$HAS_WARN" -gt 0 ]; then
  echo "=== [Pre-Commit] ⚠️  检查通过（存在警告） ==="
else
  echo "=== [Pre-Commit] ✅ 所有检查通过 ==="
fi
exit 0
