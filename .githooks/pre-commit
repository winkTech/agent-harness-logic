#!/bin/bash
# ============================================================================
# Git pre-commit hook for FPGA/ASIC projects
# 安装: git config core.hooksPath .githooks
# 功能: 仅检查 Git index：分支保护 | 大文件 | 禁止产物 | Python/Tcl 快速语法
# ============================================================================

set -o pipefail

# ─── 根目录保护 ────────────────────────────────────────────────────────────
# 确保在 git 仓库根目录运行，防止 CWD 偏移导致的路径误判
PROJECT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "❌ 无法确定 git 仓库根目录，请在 git 仓库内运行"
  exit 1
}
cd "$PROJECT_ROOT" || exit 1

echo "=== [Pre-Commit] 开始检查 ==="
echo "   仓库: $(basename "$PROJECT_ROOT")"

# ─── --no-verify 提醒 ────────────────────────────────────────────────────
if [ -n "$BYPASS_PRE_COMMIT" ] || [ -n "$SKIP_PRECOMMIT" ]; then
  echo "⚠️  检测到跳过标记。注意：--no-verify 会绕过所有检查，"
  echo "   请确保手动运行了 lint 和语法检查。"
fi

# ---- 基础变量 ----
STAGED_FILES=()
while IFS= read -r -d '' f; do
  STAGED_FILES+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
HAS_ERROR=0
HAS_WARN=0

check_cmd() { command -v "$1" &> /dev/null; }

missing_tool() {
  local tool="$1"
  local scope="$2"
  if [ "${HARNESS_PRECOMMIT_REQUIRE_TOOLS:-0}" = "1" ]; then
    echo "❌ missing tool: $tool (policy=required; scope=$scope)"
    HAS_ERROR=1
  else
    echo "⚠️  missing tool: $tool (policy=advisory; scope=$scope); deferred to explicit verification"
    HAS_WARN=1
  fi
}

# ============================================================================
# 1. 分支保护：禁止在 main 上直接提交
# ============================================================================
BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$BRANCH" = "main" ]; then
  echo "❌ 禁止在 main 分支上直接提交！请先切到功能分支。"
  exit 1
fi
echo "✅ 当前分支: $BRANCH"

# ============================================================================
# 2. 大文件检查（按 Git index blob，而非工作树文件）
# ============================================================================
MAX_BYTES="${HARNESS_PRECOMMIT_MAX_BYTES:-50000000}"
if ! [[ "$MAX_BYTES" =~ ^[0-9]+$ ]]; then
  echo "❌ HARNESS_PRECOMMIT_MAX_BYTES 必须是非负整数"
  exit 1
fi
LARGE_FILES=()
for f in "${STAGED_FILES[@]}"; do
  SIZE=$(git cat-file -s ":$f" 2>/dev/null || printf '0')
  if [ "$SIZE" -gt "$MAX_BYTES" ]; then
    LARGE_FILES+=("$f")
  fi
done
if [ "${#LARGE_FILES[@]}" -gt 0 ]; then
  echo "❌ 发现超过 ${MAX_BYTES} bytes 的暂存 blob："
  printf '  %s\n' "${LARGE_FILES[@]}"
  exit 1
fi
echo "✅ 无大文件"

# ============================================================================
# 3. 调试代码标记检查
# ============================================================================
HAS_DEBUG_SOURCE=0
for f in "${STAGED_FILES[@]}"; do
  case "$f" in
    *.v|*.sv|*.vhd|*.vhdl|*.m|*.py) HAS_DEBUG_SOURCE=1 ;;
  esac
done
if [ "$HAS_DEBUG_SOURCE" -eq 1 ]; then
  if git diff --cached --no-ext-diff --no-textconv -U0 | grep -E "^\+.*\/\/(\s*DEBUG|\s*TODO|\s*FIXME)" > /dev/null 2>&1; then
    echo "⚠️  警告：暂存区中包含 DEBUG/TODO/FIXME 标记，请确认是预期提交的代码"
    HAS_WARN=1
  fi
fi

# ============================================================================
# 4. .gitignore 存在性检查
# ============================================================================
if [ ! -f ".gitignore" ]; then
  echo "⚠️  警告：项目根目录下没有 .gitignore 文件"
  HAS_WARN=1
fi

# ============================================================================
# 5. 暂存区仿真/综合产物检查
# ============================================================================

# 排除目录（这些路径下的 work/ 等是正常数据）
# engineering-assets/ 三条: golden 向量(.bin)、资产包 vectors-ref/(规范 §5.1)、
# vendored 上游工程(含 Quartus .rpt) 均是受治理资产，不是仿真垃圾。
# 注意: 排除按路径子串匹配，资产迁出 knowledge/ 后必须由这几条接住。
# engineering-assets/var/build/ 是门禁 runner 与 run.do 的独立构建目录（已 gitignore），
# transcript/work 等仿真产物本就该落在那里，不构成仓库污染。
# engineering-assets/var/gates/ 是门禁证据目录（已 gitignore）：G-C-01/02 的判据
# 就来自其中的 timing-summary.rpt / utilization.rpt，它们是刻意产出的证据而非垃圾，
# 由 tools/pg-synth.cjs 可重生。误删会让门禁失去判据来源。
# engineering-assets/evidence/ 是证据快照目录（内含的 .dcp/.rpt 已 gitignore）：
# 与 var/gates/ 同性质 —— SNAPSHOT.json 记录各门判据，同目录下的 Vivado
# post_synth.dcp 是可由综合重跑再生的中间检查点。此前该目录未列入豁免，
# 导致本扫描把它当垃圾并阻断**与之无关**的提交。
# ---- 5a. 暂存区检查：禁止仿真文件被提交 ----
FORBIDDEN_STAGED=()
for f in "${STAGED_FILES[@]}"; do
  case "$f" in
    memory/work/*|plugins/cache/*|knowledge/*|engineering-assets/*/vectors/*|engineering-assets/*/vectors-ref/*|engineering-assets/reference-assets/*|engineering-assets/var/build/*|engineering-assets/var/gates/*|engineering-assets/evidence/*) continue ;;
  esac
  case "$f" in
    transcript|*/transcript|vsim.wlf|*/vsim.wlf|*.vcd|*.wlftmp|vsim.dump|*/vsim.dump|*.wdb|xsim.jou|*/xsim.jou|xsim.log|*/xsim.log|xsim.tcl|*/xsim.tcl|xelab.pb|*/xelab.pb|xvlog.pb|*/xvlog.pb|tr_db.log|*/tr_db.log|wev.log|*/wev.log|vlog.log|*/vlog.log)
      FORBIDDEN_STAGED+=("$f")
      ;;
  esac
done
if [ "${#FORBIDDEN_STAGED[@]}" -gt 0 ]; then
  echo "❌ 仿真产物不应提交到 git（已在暂存区）："
  printf '  %s\n' "${FORBIDDEN_STAGED[@]:0:10}"
  echo ""
  echo "  修复: git rm --cached <文件>  # 取消暂存"
  exit 1
fi
echo "✅ 暂存区无仿真产物"

# 工作区 hygiene 由显式验证/CI 负责；快速 pre-commit 不扫描未暂存或未跟踪文件。

# ============================================================================
# 6. 重型 HDL/MATLAB 检查移交显式验证
# ============================================================================
DEFERRED_HEAVY=0
for f in "${STAGED_FILES[@]}"; do
  case "$f" in
    *.v|*.sv|*.vhd|*.vhdl|*.m) DEFERRED_HEAVY=1 ;;
  esac
done

# ============================================================================
# 重工具不在 commit 热路径启动。
# ============================================================================
if [ "$DEFERRED_HEAVY" -eq 1 ]; then
  echo "ℹ️  HDL/MATLAB checks deferred (policy=explicit-verification)"
fi

# ============================================================================
# 8. Python 快速语法检查
# ============================================================================
PY_FILES=()
for f in "${STAGED_FILES[@]}"; do
  case "$f" in
    *.py)
      case "$f" in
        */examples/*|*/reference-assets/vendor/*|*/templates/*|*node_modules/*|*/plugins/cache/*|*/skills/*/scripts/*|*/skills/*/tools/*) ;;
        *) PY_FILES+=("$f") ;;
      esac
      ;;
  esac
done
if [ "${#PY_FILES[@]}" -gt 0 ]; then
  PYTHON_CMD=""
  if [ -n "${HARNESS_PRECOMMIT_PYTHON:-}" ]; then
    if check_cmd "$HARNESS_PRECOMMIT_PYTHON" && "$HARNESS_PRECOMMIT_PYTHON" -c "" &>/dev/null; then
      PYTHON_CMD="$HARNESS_PRECOMMIT_PYTHON"
    fi
  elif python -c "" &>/dev/null; then
    PYTHON_CMD="python"
  elif python3 -c "" &>/dev/null; then
    PYTHON_CMD="python3"
  fi

  if [ -n "$PYTHON_CMD" ]; then
    echo "--- [$PYTHON_CMD] 语法检查 ---"
    for f in "${PY_FILES[@]}"; do
      OUTPUT=$(git show ":$f" | timeout 15 "$PYTHON_CMD" -c 'import ast,sys; ast.parse(sys.stdin.buffer.read(), filename=sys.argv[1])' "$f" 2>&1)
      STATUS=$?
      if [ "$STATUS" -ne 0 ]; then
        echo "❌ $f 语法错误"
        echo "$OUTPUT" | sed 's/^/  /'
        HAS_ERROR=1
      else
        echo "✅ $f 语法通过"
      fi
    done
  else
    missing_tool "python" "staged .py files"
  fi

  echo "ℹ️  Python style lint deferred (policy=explicit-verification)"
fi

# ============================================================================
# 9. MATLAB 由显式验证负责
# ============================================================================
# MATLAB analysis is intentionally part of explicit/full verification, never pre-commit.

# ============================================================================
# 10. Tcl / .do / .xdc / .sdc 语法检查
# ============================================================================
TCL_FILES=()
for f in "${STAGED_FILES[@]}"; do
  case "$f" in
    *.tcl|*.do|*.xdc|*.sdc)
      case "$f" in
        */examples/*|*/reference-assets/vendor/*|*/templates/*) ;;
        *) TCL_FILES+=("$f") ;;
      esac
      ;;
  esac
done
if [ "${#TCL_FILES[@]}" -gt 0 ]; then
  TCLSH_CMD="${HARNESS_PRECOMMIT_TCLSH:-}"
  if [ -z "$TCLSH_CMD" ] && check_cmd tclsh; then
    TCLSH_CMD="tclsh"
  fi
  if [ -n "$TCLSH_CMD" ]; then
    TCL_CHECKER=$(mktemp "${TMPDIR:-/tmp}/precommit-tcl-checker.XXXXXX") || exit 1
    TCL_STAGED=$(mktemp "${TMPDIR:-/tmp}/precommit-tcl-staged.XXXXXX") || exit 1
    trap 'rm -f "$TCL_CHECKER" "$TCL_STAGED"' EXIT HUP INT TERM
    cat > "$TCL_CHECKER" <<'TCL_CHECK'
set target [lindex $argv 0]
set handle [open $target rb]
set script [read $handle]
close $handle
if {![info complete $script]} {
  puts stderr "incomplete Tcl command"
  exit 1
}
TCL_CHECK
    echo "--- [$TCLSH_CMD] Tcl 结构检查 ---"
    for f in "${TCL_FILES[@]}"; do
      if git show ":$f" > "$TCL_STAGED"; then
        OUTPUT=$(timeout 15 "$TCLSH_CMD" "$TCL_CHECKER" "$TCL_STAGED" 2>&1)
        STATUS=$?
        if [ "$STATUS" -ne 0 ]; then
          echo "❌ $f — Tcl 结构不完整"
          echo "$OUTPUT" | head -5 | sed 's/^/  /'
          HAS_ERROR=1
        else
          echo "✅ $f 结构完整"
        fi
      else
        echo "❌ 无法读取暂存 Tcl: $f"
        HAS_ERROR=1
      fi
    done
    rm -f "$TCL_CHECKER" "$TCL_STAGED"
    trap - EXIT HUP INT TERM
  else
    missing_tool "tclsh" "staged Tcl files"
  fi
fi

# ============================================================================
# 结果汇总
# ============================================================================
echo ""
if [ "$HAS_ERROR" -gt 0 ]; then
  echo "=== [Pre-Commit] ❌ 存在语法错误，提交被阻止 ==="
  exit 1
elif [ "$HAS_WARN" -gt 0 ]; then
  echo "=== [Pre-Commit] ⚠️  检查通过（存在警告） ==="
else
  echo "=== [Pre-Commit] ✅ 所有检查通过 ==="
fi
exit 0
