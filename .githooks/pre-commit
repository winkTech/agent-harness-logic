#!/bin/bash
# Git pre-commit hook for FPGA projects
# 放置在 .githooks/pre-commit，然后执行 git config core.hooksPath .githooks

echo "=== [Pre-Commit] 开始检查 ==="

# 基础变量：本次暂存的新增/修改文件
STAGED=$(git diff --cached --name-only --diff-filter=ACM)
ALL_STAGED=$(git diff --cached --name-only)

HAS_ERROR=0
HAS_WARN=0

# 辅助函数
check_cmd() {
  command -v "$1" &> /dev/null
}

# --------------------------------------------------
# 1. 检查是否在 main 分支上直接提交（禁止）
# --------------------------------------------------
BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$BRANCH" = "main" ]; then
  echo "❌ 禁止在 main 分支上直接提交！请先切到功能分支。"
  exit 1
fi
echo "✅ 当前分支: $BRANCH"

# --------------------------------------------------
# 2. 检查暂存区中是否有大文件（>50MB）
# --------------------------------------------------
LARGE_FILES=$(git diff --cached --name-only -z | xargs -0 ls -la 2>/dev/null | awk '$5 > 50000000 {print $NF}')
if [ -n "$LARGE_FILES" ]; then
  echo "❌ 发现大文件被暂存（>50MB），请添加到 .gitignore："
  echo "$LARGE_FILES"
  exit 1
fi
echo "✅ 无大文件"

# --------------------------------------------------
# 3. 检查暂存区中是否有调试代码标记
# --------------------------------------------------
if echo "$ALL_STAGED" | grep -qE '\.(v|sv|vhd|m|py)$'; then
  if git diff --cached -U0 | grep -E "^\+.*\/\/(\s*DEBUG|\s*TODO|\s*FIXME)" > /dev/null 2>&1; then
    echo "⚠️  警告：暂存区中包含 DEBUG/TODO/FIXME 标记，请确认是预期提交的代码"
    HAS_WARN=1
  fi
fi

# --------------------------------------------------
# 4. 检查 .gitignore 是否存在
# --------------------------------------------------
if [ ! -f ".gitignore" ]; then
  echo "⚠️  警告：项目根目录下没有 .gitignore 文件"
  HAS_WARN=1
fi

# --------------------------------------------------
# 5. 检查仿真产物是否被暂存
# --------------------------------------------------
# 排除的目录（不检查这些路径下的 work/）
EXCLUDE_DIRS="memory/work/|plugins/cache/"
FORBIDDEN_PATTERNS="transcript|vsim\.wlf|\.vcd$|\.wlftmp|vsim\.dump"
MATCH=$(echo "$ALL_STAGED" | grep -E "$FORBIDDEN_PATTERNS" | grep -vE "$EXCLUDE_DIRS" | head -5)
if [ -n "$MATCH" ]; then
  echo "❌ 仿真产物不应提交到 git："
  echo "$MATCH"
  exit 1
fi
echo "✅ 无仿真产物混入"

# --------------------------------------------------
# 6. Verilog / SystemVerilog 语法检查（排除 examples/templates）
# --------------------------------------------------
SV_FILES=$(echo "$STAGED" | grep -E '\.(v|sv)$' | grep -v '/examples/' | grep -v '/templates/')
if [ -n "$SV_FILES" ]; then
  if check_cmd vlog; then
    echo "--- [vlog] 检查 Verilog/SV 语法 ---"
    for f in $SV_FILES; do
      if [ -f "$f" ]; then
        OUTPUT=$(vlog -lint "$f" 2>&1)
        ERRORS=$(echo "$OUTPUT" | grep -cE "^(# )?\*\* Error")
        WARNINGS=$(echo "$OUTPUT" | grep -cE "^(# )?\*\* Warning")
        if [ "$ERRORS" -gt 0 ]; then
          echo "❌ $f — $ERRORS 个错误, $WARNINGS 个警告"
          echo "$OUTPUT" | grep -E "^\*\* Error" | head -5 | sed 's/^/  /'
          HAS_ERROR=1
        else
          echo "✅ $f — $WARNINGS 个警告"
        fi
      fi
    done
  else
    echo "⚠️  未找到 vlog 命令，跳过 SV 检查"
  fi
fi

# --------------------------------------------------
# 7. VHDL 语法检查（排除 examples/templates）
# --------------------------------------------------
VHD_FILES=$(echo "$STAGED" | grep -E '\.(vhd|vhdl)$' | grep -v '/examples/' | grep -v '/templates/')
if [ -n "$VHD_FILES" ]; then
  if check_cmd vcom; then
    echo "--- [vcom] 检查 VHDL 语法 ---"
    for f in $VHD_FILES; do
      if [ -f "$f" ]; then
        OUTPUT=$(vcom -lint "$f" 2>&1)
        ERRORS=$(echo "$OUTPUT" | grep -cE "^(# )?\*\* Error")
        WARNINGS=$(echo "$OUTPUT" | grep -cE "^(# )?\*\* Warning")
        if [ "$ERRORS" -gt 0 ]; then
          echo "❌ $f — $ERRORS 个错误, $WARNINGS 个警告"
          echo "$OUTPUT" | grep -E "^\*\* Error" | head -5 | sed 's/^/  /'
          HAS_ERROR=1
        else
          echo "✅ $f — $WARNINGS 个警告"
        fi
      fi
    done
  else
    echo "⚠️  未找到 vcom 命令，跳过 VHDL 检查"
  fi
fi

# --------------------------------------------------
# 8. Python 语法和 lint 检查（排除外部代码和缓存）
# --------------------------------------------------
PY_FILES=$(echo "$STAGED" | grep -E '\.py$' | grep -v '/examples/' | grep -v '/templates/' | grep -v 'node_modules/' | grep -v '/plugins/cache/' | grep -v '/skills/.*/scripts/' | grep -v '/skills/.*/tools/')
if [ -n "$PY_FILES" ]; then
  # Windows 上 python3 可能指向微软商店，优先用 python
  PYTHON_CMD=""
  if python -c "" &>/dev/null; then
    PYTHON_CMD="python"
  elif python3 -c "" &>/dev/null; then
    PYTHON_CMD="python3"
  fi

  if [ -n "$PYTHON_CMD" ]; then
    echo "--- [$PYTHON_CMD] 语法检查 ---"
    for f in $PY_FILES; do
      if [ -f "$f" ]; then
        OUTPUT=$($PYTHON_CMD -m py_compile "$f" 2>&1)
        if [ -n "$OUTPUT" ]; then
          echo "❌ $f 语法错误"
          echo "$OUTPUT" | sed 's/^/  /'
          HAS_ERROR=1
        else
          echo "✅ $f 语法通过"
        fi
      fi
    done
  fi

  # flake8（如已安装）
  if check_cmd flake8; then
    echo "--- [flake8] 代码风格检查 ---"
    for f in $PY_FILES; do
      if [ -f "$f" ]; then
        OUTPUT=$(flake8 --max-line-length=100 "$f" 2>&1)
        if [ -n "$OUTPUT" ]; then
          echo "⚠️  $f"
          echo "$OUTPUT" | head -10 | sed 's/^/  /'
          HAS_WARN=1
        else
          echo "✅ $f flake8 通过"
        fi
      fi
    done
  fi

  # ruff（如已安装，比 flake8 更快）
  if check_cmd ruff; then
    echo "--- [ruff] 代码检查 ---"
    for f in $PY_FILES; do
      if [ -f "$f" ]; then
        OUTPUT=$(ruff check "$f" 2>&1)
        if [ -n "$OUTPUT" ]; then
          echo "⚠️  $f"
          echo "$OUTPUT" | head -10 | sed 's/^/  /'
          HAS_WARN=1
        else
          echo "✅ $f ruff 通过"
        fi
      fi
    done
  fi

  if ! check_cmd flake8 && ! check_cmd ruff; then
    echo "⚠️  建议安装 linter: pip install flake8 或 pip install ruff"
  fi
fi

# --------------------------------------------------
# 9. MATLAB 代码检查（仅安装时启用，启动较慢，排除 examples/templates）
# --------------------------------------------------
M_FILES=$(echo "$STAGED" | grep -E '\.m$' | grep -v '/examples/' | grep -v '/templates/')
if [ -n "$M_FILES" ]; then
  if check_cmd matlab; then
    echo "--- [MATLAB] 代码分析 ---"
    for f in $M_FILES; do
      if [ -f "$f" ]; then
        # 使用 batch 模式运行 checkcode，超时 120s
        OUTPUT=$(timeout 120 matlab -batch "checkcode('$f'); exit;" 2>&1)
        if echo "$OUTPUT" | grep -qi "error\|警告\|L \d"; then
          echo "⚠️  $f 存在代码分析问题："
          echo "$OUTPUT" | grep -E "L \d|Error|警告" | head -10 | sed 's/^/  /'
          HAS_WARN=1
        else
          echo "✅ $f MATLAB 分析通过"
        fi
      fi
    done
  else
    echo "⚠️  未找到 matlab 命令，跳过 .m 文件检查"
  fi
fi

echo ""
if [ "$HAS_ERROR" -gt 0 ]; then
  echo "=== [Pre-Commit] ❌ 存在语法错误，提交被阻止 ==="
  exit 1
elif [ "$HAS_WARN" -gt 0 ]; then
  echo "=== [Pre-Commit] ⚠️  检查通过（存在警告） ==="
else
  echo "=== [Pre-Commit] ✅ 所有检查通过 ==="
fi
