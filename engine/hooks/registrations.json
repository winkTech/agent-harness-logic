{
  "version": 1,
  "$comment": [
    "Hook 注册的**唯一权威声明**，入版本库。",
    "settings.json 本身被 .gitignore 忽略（hook 命令必须写本机绝对路径，改用 $HOME 会导致",
    "hook 静默不触发），所以新克隆和 CI 都拿不到",
    "任何 hook 注册 —— engine/hooks/manifest.json 声称 active 的条目会全部核对不上。",
    "本文件用 {{HARNESS_ROOT}} 占位符保持可移植，由 engine/scripts/render-hook-settings.cjs",
    "渲染成带绝对路径的 settings.json。改 hook 注册请改这里，然后跑渲染器。"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {{HARNESS_ROOT}}/engine/scripts/hooks/preflight-router.cjs",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|PowerShell|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node {{HARNESS_ROOT}}/engine/hooks/learning/postflight-observer.cjs",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node {{HARNESS_ROOT}}/engine/scripts/hooks/postflight-router.cjs",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node {{HARNESS_ROOT}}/engine/scripts/hooks/codegraph-sync.cjs --file",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {{HARNESS_ROOT}}/engine/hooks/learning/postflight-observer.cjs",
            "timeout": 5,
            "async": true
          },
          {
            "type": "command",
            "command": "node {{HARNESS_ROOT}}/engine/scripts/hooks/postflight-router.cjs",
            "timeout": 12
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {{HARNESS_ROOT}}/engine/scripts/hooks/prompt-context.cjs",
            "timeout": 8
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node {{HARNESS_ROOT}}/engine/scripts/hooks/session-bootstrap.cjs",
            "timeout": 12
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node {{HARNESS_ROOT}}/engine/scripts/memory-knowledge-maintenance.cjs --auto --execute",
            "timeout": 120,
            "async": true
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node {{HARNESS_ROOT}}/engine/scripts/hooks/codegraph-sync.cjs --session",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {{HARNESS_ROOT}}/engine/scripts/hooks/stop-summary.cjs",
            "timeout": 40
          },
          {
            "type": "command",
            "command": "node {{HARNESS_ROOT}}/engine/hooks/learning/postflight-observer.cjs",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {{HARNESS_ROOT}}/engine/scripts/hooks/subagent-verdict.cjs",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {{HARNESS_ROOT}}/engine/scripts/pre-compact.cjs"
          }
        ]
      }
    ]
  }
}
