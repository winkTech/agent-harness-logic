# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram user ID (get from @userinfobot)
TELEGRAM_OWNER_ID=your_user_id_here

# Comma-separated list of allowed user IDs (include your owner ID)
TELEGRAM_ALLOWED_USERS=your_user_id_here

# Optional: Set to "true" to allow all users (not recommended for production)
# TELEGRAM_ALLOW_ALL=false
