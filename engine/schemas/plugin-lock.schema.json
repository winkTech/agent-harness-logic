{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.harness/schemas/plugin-lock.schema.json",
  "title": "Enabled Plugin Lock",
  "description": "Portable lock for plugins enabled by settings.local.json. Local cache paths and timestamps are intentionally excluded.",
  "type": "object",
  "required": ["$schema", "version", "plugins"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "./engine/schemas/plugin-lock.schema.json"
    },
    "version": {
      "const": 1
    },
    "plugins": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^.+@.+$"
      },
      "additionalProperties": {
        "type": "object",
        "required": ["version", "gitCommitSha"],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1
          },
          "gitCommitSha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    }
  }
}
