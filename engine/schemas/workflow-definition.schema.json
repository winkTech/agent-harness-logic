{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lihan.local/schemas/workflow-definition.schema.json",
  "title": "Workflow Definition Contract",
  "type": "object",
  "required": ["name", "description", "phases", "contract"],
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title"],
        "additionalProperties": true,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "detail": { "type": "string" }
        }
      }
    },
    "contract": {
      "type": "object",
      "required": ["version", "strict", "inputs", "checkpoints", "evidence", "completionCriteria"],
      "additionalProperties": true,
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "strict": { "const": true },
        "inputs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "checkpoints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "completionCriteria": {
          "type": "array",
          "items": { "type": "string" }
        },
        "modeContracts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["allowedSkips", "requiredEvidence"],
            "additionalProperties": true,
            "properties": {
              "allowedSkips": {
                "type": "array",
                "items": { "type": "string" }
              },
              "requiredEvidence": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
