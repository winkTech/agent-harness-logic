{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "40",
    "CLAUDE_MAX_CONTEXT_WINDOW": "1000000",
    "SPAWN_SKILL_SECTION_MODE": "names_only",
    "SPAWN_PROMPT_BUDGET_LOG": "on",
    "SPAWN_ASSEMBLY_CACHE": "on",
    "SPAWN_ASSEMBLY_CACHE_TTL_MS": "300000",
    "AGENT_TYPED_MEMORY_INJECTION": "on"
  },
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "github@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(git commit:*)"
    ],
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "WebFetch",
      "NotebookEdit"
    ],
    "defaultMode": "bypassPermissions",
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push origin master)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f*:*)",
      "Bash(git branch -D:*)",
      "Bash(git checkout -- *:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(git push --delete:*)",
      "Bash(git push origin :*)",
      "Bash(git tag -d:*)",
      "Bash(gh repo delete:*)",
      "Bash(git commit --amend:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/Lihan/.claude/engine/hooks/session/progress-watchdog.cjs",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/Lihan/.claude/engine/scripts/hooks/repair-content-gate.cjs",
            "timeout": 3000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/Lihan/.claude/engine/scripts/hooks/toolchain-health-gate.cjs",
            "timeout": 3000
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/Lihan/.claude/engine/hooks/session/progress-watchdog.cjs",
            "timeout": 3000
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "matlab": {
      "command": "D:\\Program Files\\MATLAB-MCP\\matlab-mcp-server.exe",
      "args": [
        "--matlab-root", "D:\\MATLAB\\R2025a",
        "--initialize-matlab-on-startup", "false",
        "--matlab-display-mode", "nodesktop",
        "--disable-telemetry", "true",
        "--log-folder", "D:\\MATLAB\\MCP-logs"
      ]
    }
  }
}
