{
  "env": {
    "CLAUDE_MAX_CONTEXT_WINDOW": "1000000",
    "SPAWN_SKILL_SECTION_MODE": "names_only",
    "SPAWN_PROMPT_BUDGET_LOG": "on",
    "SPAWN_ASSEMBLY_CACHE": "on",
    "SPAWN_ASSEMBLY_CACHE_TTL_MS": "300000",
    "AGENT_TYPED_MEMORY_INJECTION": "on",
    "CLAUDE_RULE_CAPSULE_MAX_CHARS": "900",
    "CLAUDE_RULE_SIGNAL_DISABLED": "1",
    "PROGRESS_WATCHDOG_MODE": "observe",
    "CLAUDE_TOOL_ACTION_CONTRACT_MODE": "high-risk",
    "CLAUDE_CONTEXT_MONITOR_AUTO_CHECKPOINT": "0"
  },
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "github@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(git commit:*)",
      "PowerShell(git push:*)",
      "PowerShell(gh pr merge:*)",
      "PowerShell(git commit:*)"
    ],
    "allow": [
      "Read",
      "Write",
      "Edit",
      "WebFetch",
      "NotebookEdit",
      "Bash(git push:*)",
      "PowerShell(git push:*)"
    ],
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push origin master)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f*:*)",
      "Bash(git branch -D:*)",
      "Bash(git checkout -- *:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(git push --delete:*)",
      "Bash(git push origin :*)",
      "Bash(git tag -d:*)",
      "Bash(gh repo delete:*)",
      "Bash(git commit --amend:*)",
      "PowerShell(git push origin main)",
      "PowerShell(git push origin master)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git clean -f*:*)",
      "PowerShell(git branch -D:*)",
      "PowerShell(git checkout -- *:*)",
      "PowerShell(git push --delete:*)",
      "PowerShell(git push origin :*)",
      "PowerShell(git tag -d:*)",
      "PowerShell(gh repo delete:*)",
      "PowerShell(git commit --amend:*)",
      "PowerShell(Remove-Item -Recurse -Force /:*)",
      "PowerShell(Remove-Item -Recurse -Force ~:*)"
    ]
  }
}
