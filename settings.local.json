{
  "env": {
    "ECC_DISABLED_HOOKS": "pre:edit-write:gateguard-fact-force",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "40"
  },
  "hooks": {
    "PostStop": [
      {
        "run": "bash ~/.claude/scripts/hooks/resolve-plugin-path.sh session-end.js",
        "async": true,
        "timeout": 15000
      }
    ],
    "SessionStart": [
      {
        "run": "bash ~/.claude/scripts/hooks/resolve-plugin-path.sh session-start.js",
        "timeout": 10000
      },
      {
        "run": "bash ~/.claude/scripts/hooks/memory-track.sh session-start",
        "timeout": 15000
      }
    ],
    "PostMessage": [
      {
        "run": "bash ~/.claude/scripts/hooks/memory-track.sh post-message",
        "async": true,
        "timeout": 5000
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"var p=require('path'),h=require('os').homedir();require('child_process').spawnSync('node',[p.join(h,'.claude/scripts/hooks/pre-commit-lint.js')],{stdio:'inherit',env:process.env,cwd:process.cwd()})\"",
            "description": "Pre-commit lint check: run vlog/ruff on staged .v/.sv/.py before git commit",
            "id": "pre:bash:pre-commit-lint"
          },
          {
            "type": "command",
            "command": "node -e \"var p=require('path'),h=require('os').homedir();require('child_process').spawnSync('node',[p.join(h,'.claude/scripts/hooks/diff-size-gate.js')],{stdio:'inherit',env:process.env,cwd:process.cwd()})\"",
            "description": "Diff-size gate: block git push if change set exceeds thresholds",
            "id": "pre:bash:diff-size-gate"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"var p=require('path'),h=require('os').homedir();require('child_process').spawnSync('node',[p.join(h,'.claude/scripts/hooks/lint-auto-gate.js')],{stdio:'inherit',env:process.env,cwd:process.cwd()})\"",
            "description": "Auto lint gate: run vlog/ruff on modified .v/.sv/.py files at end of response",
            "id": "stop:lint-auto-gate"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "Mixedbread-Grep": {
      "source": {
        "source": "git",
        "url": "https://github.com/mixedbread-ai/mgrep.git"
      }
    },
    "karpathy-skills": {
      "source": {
        "source": "git",
        "url": "https://github.com/forrestchang/andrej-karpathy-skills.git"
      }
    }
  },
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "everything-claude-code@everything-claude-code": true,
    "mgrep@Mixedbread-Grep": true,
    "coding-tutor@coding-tutor": true,
    "code-review@claude-plugins-official": true,
    "compound-engineering@compound-engineering": true,
    "github@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(git commit:*)"
    ],
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "WebFetch",
      "NotebookEdit"
    ],
    "defaultMode": "bypassPermissions",
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push origin master)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f*:*)",
      "Bash(git branch -D:*)",
      "Bash(git checkout -- *:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(git push --delete:*)",
      "Bash(git push origin :*)",
      "Bash(git tag -d:*)",
      "Bash(gh repo delete:*)",
      "Bash(git commit --amend:*)"
    ]
  }
}
