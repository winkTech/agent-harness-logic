{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "engineering-assets/schemas/cbb-manifest.schema.json",
  "title": "CBB Manifest (MVP)",
  "description": "生产级 CBB 资产 manifest。单一真相源。字段依据《CBB 库治理与生产级准入规范 V1.0》§6。MVP 子集；scale-up 字段（timing_closure/generality 全维/lineage 等）可选。",
  "type": "object",
  "additionalProperties": false,
  "comment_levels": "required 按 maturity.level 条件化（规范 §3.1）。reference 级只要求 asset_uid + provenance + owner + 未认证横幅，不得强制 RTL 形状字段（ports/clock/reset/golden_model_ref）——否则 vendored 上游工程与 knowledge 文档资产无法纳入治理。intake 及以上要求完整锚链与 RTL 契约。",
  "required": [
    "schema_version", "asset_uid", "name", "owner", "maturity"
  ],
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "golden-model" } }, "required": ["kind"] },
      "then": {
        "comment": "正确性锚自身：它就是 golden，故无 golden_model_ref；是 .m/.hex，故无 ports/clock/reset。",
        "required": ["version", "requirement_ref", "models", "sources"]
      },
      "else": {
        "if": { "properties": { "maturity": { "properties": { "level": { "const": "reference" } }, "required": ["level"] } }, "required": ["maturity"] },
        "then": { "required": ["provenance", "banner"] },
        "else": {
          "if": { "properties": { "kind": { "const": "primitive" } }, "required": ["kind"] },
          "then": {
            "comment": "结构原语 (owner 裁决 2026-07-27): golden model 锚的是算法, 不是所有模块。RAM/skid buffer/延迟线/CDC/LFSR 这类结构原语的正确性锚 = 自检 TB (G-B-02/03 按类分锚), 任何成熟度级别都不要求 golden_model_ref/fidelity 对标字段。",
            "required": [
              "version", "requirement_ref", "doc_refs",
              "ports", "clock", "reset", "sources"
            ]
          },
          "else": {
          "if": { "properties": { "maturity": { "properties": { "level": { "const": "intake" } }, "required": ["level"] } }, "required": ["maturity"] },
          "then": {
            "comment": "intake 准入 = schema-valid + 编译干净 + 锚链起点（规范 §3.1 L152-153）。golden 绑定(G-B-02)与资源包络(G-C-02 constraints.target)是晋级 qualification/certified 的门, 不是 intake 的形状要求 —— 否则无算法 golden 的结构原语(skid buffer/RAM 等)永远进不了 intake。",
            "required": [
              "version", "requirement_ref", "doc_refs",
              "ports", "clock", "reset", "sources"
            ]
          },
          "else": {
            "required": [
              "version", "requirement_ref", "doc_refs", "golden_model_ref",
              "fidelity", "ports", "clock", "reset", "constraints", "sources"
            ]
          }
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "asset_uid": { "type": "string", "pattern": "^[a-z0-9_]+$", "description": "唯一引用锚（MVP 允许人读 slug）" },
    "name": { "type": "string", "description": "人读模块名（非引用锚）" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "owner": { "type": "string", "description": "具名真人 DRI" },
    "maturity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "type": "string", "enum": ["reference", "intake", "qualification", "certified", "deprecated"] },
        "evidence_ref": { "type": "string" }
      }
    },
    "requirement_ref": { "type": "string", "description": "锚链起点：需求条目 id/URI" },
    "doc_refs": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "方向锚：设计前期文档/ADR" },
    "golden_model_ref": { "type": "string", "description": "正确性锚：配对 golden 资产 asset_uid" },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compare_mode": { "type": "string", "enum": ["cycle_accurate", "transaction_based", "scoreboard"] },
        "pipeline_delay_min": { "type": "integer", "minimum": 0 },
        "pipeline_delay_max": { "type": "integer", "minimum": 0 }
      },
      "required": ["compare_mode"]
    },
    "fidelity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["bit_true", "tolerance", "pending", "na"], "description": "na 仅限 kind=primitive: 结构原语无 golden 对标概念, 正确性由自检 TB 承担" },
        "bit_accurate_against": { "type": "string" },
        "tolerance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": { "type": "number" },
            "rationale": { "type": "string" },
            "set_at": { "type": "string" }
          }
        }
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "direction", "width"],
        "properties": {
          "name": { "type": "string" },
          "direction": { "type": "string", "enum": ["input", "output", "inout"] },
          "width": { "type": "integer", "minimum": 1 },
          "bus": { "type": "string", "description": "协议归属，如 axi-stream；命名门禁据此豁免" }
        }
      }
    },
    "top": { "type": "string", "description": "综合顶层模块名；缺省时 pg-synth 回退到 name" },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "description": "目标器件。G-C-01/02 的 WNS 与资源数只对特定 part+speed grade 成立，不声明则综合证据无法解释",
      "required": ["part"],
      "properties": {
        "part": { "type": "string", "description": "Vivado 完整 part 名，如 xc7k325tffg900-2" },
        "family": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "period_ns": { "type": "number", "minimum": 0.1 }
      }
    },
    "clocks": {
      "type": "array",
      "minItems": 2,
      "description": "多时钟域资产（如 CDC 原语）的全部时钟。单数 clock 字段仍必填并指主域（约定：数据消费侧/dst 域），本数组补全其余域。单时钟资产不得使用本字段。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "domain"],
        "properties": {
          "name": { "type": "string" },
          "domain": { "type": "string", "description": "域角色标注, 如 src/dst" },
          "period_ns": { "type": "number", "minimum": 0.1 },
          "relationship": { "type": "string", "enum": ["asynchronous", "synchronous", "mesochronous"] }
        }
      }
    },
    "resets": {
      "type": "array",
      "minItems": 2,
      "description": "多时钟域资产的全部复位, 与 clocks 配套。单数 reset 字段仍必填并指主域。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "domain", "polarity", "type"],
        "properties": {
          "name": { "type": "string" },
          "domain": { "type": "string" },
          "polarity": { "type": "string", "enum": ["active_high", "active_low"] },
          "type": { "type": "string", "enum": ["sync", "async"] },
          "async_release_synchronized": { "type": "boolean" }
        }
      }
    },
    "reset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "polarity", "type"],
      "properties": {
        "name": { "type": "string" },
        "polarity": { "type": "string", "enum": ["active_high", "active_low"] },
        "type": { "type": "string", "enum": ["sync", "async"] },
        "async_release_synchronized": { "type": "boolean" }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target"],
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": true,
          "required": ["fmax"],
          "properties": {
            "fmax": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?\\s*(MHz|kHz|Hz)$" },
            "fmax_mhz": { "type": "number", "minimum": 0 },
            "lut": { "type": "integer", "minimum": 0 },
            "ff": { "type": "integer", "minimum": 0 },
            "bram": { "type": "integer", "minimum": 0 },
            "dsp": { "type": "integer", "minimum": 0 },
            "latency": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "note": { "type": "string" },
          "role": {
            "type": "string",
            "description": "前 5 个为 rtl 域；后 7 个为 golden-model 域（规范 §1 正确性锚的双模型 + 其配套）。",
            "enum": [
              "rtl", "tb", "constraint", "vector", "doc",
              "reference", "fixed_point", "config", "vector_gen", "sim", "test", "harness"
            ]
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "generality": { "type": "object" },
    "signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "at", "scope"],
      "properties": {
        "by": { "type": "string" },
        "at": { "type": "string" },
        "scope": { "type": "array", "items": { "type": "string" } },
        "panel_verdicts_ref": { "type": "string" }
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "reason", "approver", "expires_at"],
        "properties": {
          "gate": { "type": "string" },
          "reason": { "type": "string" },
          "approver": { "type": "string" },
          "expires_at": { "type": "string" },
          "evidence_ref": { "type": "string" }
        }
      }
    },
    "superseded_by": { "type": ["string", "null"] },

    "kind": {
      "type": "string",
      "enum": ["rtl", "primitive", "golden-model", "vendor", "knowledge"],
      "description": "资产域（规范 §1 三个锚 + vendored）。缺省视为 rtl，保持既有 CBB 包向后兼容。primitive = 结构原语 (RAM/skid buffer/延迟线/CDC/LFSR 等)：正确性锚 = 自检 TB，不要求 golden model（owner 裁决 2026-07-27：golden 锚的是算法，不是所有模块）。"
    },
    "implements_for": {
      "type": "array", "items": { "type": "string" },
      "description": "golden-model 专用：本模型作为哪些 CBB 的正确性锚（asset_uid 列表）"
    },
    "models": {
      "type": "array",
      "description": "golden-model 专用：双模型张力（规范 §1）——reference(浮点/普遍性) + fixed_point(定点/设计特性)",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "path"],
        "properties": {
          "role": { "type": "string", "enum": ["reference", "fixed_point"] },
          "trait": { "type": "string" },
          "path": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "vectors": { "type": "object", "additionalProperties": true },

    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "license", "retrieved"],
      "description": "reference 级来源登记（规范 §3.1）。source 未确证时填 unresolved，不得臆造。",
      "properties": {
        "source": { "type": "string" },
        "source_basis": { "type": "string", "description": "来源的确证依据（如与上游 README 逐字比对）" },
        "license": { "type": "string" },
        "retrieved": { "type": "string" },
        "retrieved_basis": { "type": "string" },
        "commit": { "type": ["string", "null"] }
      }
    },
    "banner": { "type": "string", "description": "reference 级必需的“未认证”横幅文本" },
    "content": {
      "type": "object",
      "additionalProperties": true,
      "description": "归档内容规模（files/size），仅供人读盘点"
    },
    "notes": { "type": "string" }
  }
}
