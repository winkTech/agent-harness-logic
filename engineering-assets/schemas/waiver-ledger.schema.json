{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "engineering-assets/schemas/waiver-ledger.schema.json",
  "title": "CBB waiver ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "asset_uid", "gate", "reason", "scope", "approver", "opened_at", "expires_at", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^W-[A-Z0-9_-]+$" },
          "asset_uid": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "gate": { "type": "string" },
          "flag_id": { "type": "string" },
          "reason": { "type": "string", "minLength": 1 },
          "scope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "approver": { "type": "string", "minLength": 1 },
          "opened_at": { "type": "string" },
          "expires_at": { "type": "string" },
          "status": { "type": "string", "enum": ["open", "closed", "expired"] },
          "evidence_ref": { "type": "string" },
          "resolution": { "type": "string" },
          "closed_at": { "type": "string" }
        }
      }
    }
  }
}
